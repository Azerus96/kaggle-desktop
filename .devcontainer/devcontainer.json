{
  "name": "Codespaces Desktop with Chrome",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest"
    }
  },
  "runArgs": [
    "--shm-size=2g"
  ],
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-desktop.sh",
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Web Desktop (noVNC)",
      "onAutoForward": "openBrowser"
    }
  }
}
